# ─── Application ────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api

# ─── Base de données PostgreSQL (Docker) ────────
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ms_express
DB_PASSWORD=ms_express_dev_password
DB_DATABASE=ms_express
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ─── JWT ────────────────────────────────────────
JWT_SECRET=ms_express_super_secret_dev_key_change_me_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=ms_express_refresh_secret_dev_key_change_me
JWT_REFRESH_EXPIRES_IN=30d

# ─── CORS ───────────────────────────────────────
CORS_ORIGIN=*